rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Investors can read/write their own profile
      // Admins can read/write all profiles
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    match /documents/{docId} {
      // Investors can read if targeted to 'all' or if their uid is in allowed_uids
      // Admins can read and write everything
      allow read: if request.auth != null && (
        isAdmin() || 
        resource.data.target_audience == 'all' || 
        request.auth.uid in resource.data.allowed_uids
      );
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by'])
      );
      allow create, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null && (
        isAdmin() || 
        !('target_audience' in resource.data) ||
        resource.data.target_audience == 'all' || 
        (resource.data.target_audience == 'custom' && request.auth.uid in resource.data.allowed_uids)
      );
      allow write: if isAdmin();
    }
  }
}
